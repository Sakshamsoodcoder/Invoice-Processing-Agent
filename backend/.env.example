# Environment Mode: 'production' or 'development'
ENVIRONMENT=production

# Server Binding
HOST=0.0.0.0
PORT=8000

# PostgreSQL Connection String (Provided by Render PostgreSQL or external PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Note: Render provides "postgres://", which the backend automatically converts to "postgresql://"
DATABASE_URL=postgresql://username:password@dpg-xxxxxx-a.render.com/invoice_ai_db

# Allowed CORS Origins (Comma-separated, without trailing slashes)
# In addition, https://*.vercel.app is automatically supported by regex
CORS_ORIGINS=https://invoice-processing-agent-inky.vercel.app,http://localhost:5173

# Security & Authentication
JWT_SECRET=replace_with_a_secure_random_secret_minimum_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Azure Document Intelligence (Form Recognizer)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-document-intelligence-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=your_azure_document_intelligence_key_here

# Azure OpenAI (or Microsoft Foundry)
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage_account_name>;AccountKey=<account_key>;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=invoices
LOCAL_STORAGE_DIR=./uploads
