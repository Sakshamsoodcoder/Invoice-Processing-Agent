# Environment Configuration for InvoiceAI

# Application Mode: 'development' or 'production'
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security / Authentication
JWT_SECRET=super_secret_jwt_key_invoice_ai_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL default, auto-fallback to SQLite if connection fails)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invoice_ai
# SQLite Fallback: sqlite:///./invoice_ai.db

# Azure Document Intelligence (leave blank for Development / Mock Mode)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Microsoft Foundry / Azure OpenAI (leave blank for Development / Mock Mode)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Azure Blob Storage (leave blank for local uploads/ directory fallback)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=invoices

# Local storage path (used when AZURE_STORAGE_CONNECTION_STRING is not set)
LOCAL_STORAGE_DIR=./uploads
